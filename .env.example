# Copiar como .env y rellenar valores reales

# Clave secreta aleatoria para sesiones Flask
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API key de OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Nombre del negocio que aparece en la app
BUSINESS_NAME=Mi Negocio

# Base de datos — en Railway usar la URL de PostgreSQL que Railway provee automáticamente
DATABASE_URL=sqlite:///instance/app.db

# Unidades mínimas para alertar bajo stock (default: 10)
LOW_STOCK_THRESHOLD=10
